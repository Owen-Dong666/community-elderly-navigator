# 可选：mock / openai_compatible / ollama
MODEL_PROVIDER=mock
# 云端兼容接口示例：https://api.example.com
# 本地 Ollama 示例：http://127.0.0.1:11434
MODEL_BASE_URL=
# 云端填写实际模型名；Ollama 建议填写 qwen3:0.6b
MODEL_NAME=
# mock 和 Ollama 模式留空；不要把真实密钥提交到 Git
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=20
KNOWLEDGE_PATH=data/demo_community.json
# 现场演示可为 true；正式部署如不需查看知识库可改为 false
EXPOSE_KNOWLEDGE_API=true

