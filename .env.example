# 复制为 .env 后填写。密钥不要提交到 Git，也不要发送到聊天记录。
# 现场断网：ollama；云端联调：openai_compatible
MODEL_PROVIDER=ollama

# 必须预先在本机安装 Ollama 并下载模型；填写 ollama list 中的准确名称。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# 云端服务的 OpenAI 兼容 API 根地址（通常以 /v1 结尾）
CLOUD_BASE_URL=
CLOUD_MODEL=
CLOUD_API_KEY=

# 等待模型响应的秒数，可根据本机性能调整（1–600）。
MODEL_TIMEOUT_SECONDS=120
